{
  "name": "shakespeare-gui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/lib/shakespeare-gui.js",
  "module": "./dist/lib/shakespeare-gui.js",
  "exports": {
    ".": "./dist/lib/shakespeare-gui.js",
    "./style.css": "./dist/lib/shakespeare-gui.css"
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "build:lib": "vite build --mode lib",
    "test": "task test",
    "prepare": "husky"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.10.3",
    "@popperjs/core": "^2.11.8",
    "@umoteam/editor": "^11.1.1",
    "bootstrap": "^5.3.8",
    "browserfs": "^1.4.3",
    "chart.js": "^4.5.1",
    "isomorphic-git": "^1.42.6",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.29.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "less": "^4.9.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "description": "Unified graphical user interface of Shakespeare, shared by every platform release (web, desktop, mobile) - for writters to writters to write books easier, better and with results attchiving faster",
  "keywords": [
    "shakespeare",
    "vue",
    "gui"
  ],
  "author": "Sett Sarverott A.A.B. <sett@sarverott.com> (https://sett.sarverott.com)",
  "homepage": "https://github.com/Sarverott/shakespeare-gui#readme",
  "bugs": {
    "url": "https://github.com/Sarverott/shakespeare-gui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarverott/shakespeare-gui.git"
  },
  "overrides": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-unique-id": {
      "uuid": "^11.1.1"
    },
    "@tiptap/extension-table-of-contents": {
      "uuid": "^11.1.1"
    }
  }
}
